{
  "ConnectionStrings": {
    "Default": "Data Source=gmvtm.db"
  },
  // For this small exam project we intentionally use simple HTTP Basic auth (one username, no
  // claims or roles). The password is not kept in plain text, PasswordHashSha256 is the SHA256
  // hash of the API password, and the server compares hashes on every request
  // unhashed use "dieengele" (note this is just a example project)
  "Auth": {
    "Username": "ladot",
    "PasswordHashSha256": "5081337d6550161935bc6c4a78cc3dd169f1a440b8e83eb79bef6b45307d7855"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gmvtm-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
